PLAYWRIGHT_BASE_URL=http://localhost:5173

# URL base del backend (sin sufijo /api — Nginx lo añade solo en producción).
# Usada por global-setup.ts y los fixtures para llamar a /testing/reset y /testing/login.
PLAYWRIGHT_API_URL=http://localhost:3000

# Los endpoints /testing/* solo existen cuando el backend arranca con E2E_TESTING=true.
# NUNCA activar E2E_TESTING=true en producción.
# En CI este valor se inyecta directamente como variable de entorno del workflow.
