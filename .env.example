POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=database_name
VITE_BACK_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_key
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@lw-postgres:5432/${POSTGRES_DB}?schema=public"
FRONTEND_URL="http://localhost:5173"

# Mail — Gmail OAuth2 (producción). En dev se ignoran y se usa Ethereal automáticamente.
MAIL_USER=your@gmail.com
MAIL_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
MAIL_OAUTH_CLIENT_SECRET=your-client-secret
MAIL_OAUTH_REFRESH_TOKEN=your-refresh-token
RESET_TOKEN_EXPIRY_MINUTES=30

# Single-session enforcement — grace period (ms) before clearing session on socket disconnect.
# Allows page refreshes without locking the user out. Default: 30000 (30 s).
SESSION_DISCONNECT_TIMEOUT_MS=3000

# E2E testing flag — enables the /testing/* endpoints (reset, seed, login) used by Playwright.
# DO NOT SET TO true IN PRODUCTION (the backend also refuses to load TestingModule when
# NODE_ENV=production, but keep this off in any prod-like environment as defense in depth).
E2E_TESTING=false

# Friend invitation lifetime in seconds (default 300 seconds / 5 minutes)
FRIEND_INVITATION_TTL_SECONDS=300

# TURN server for WebRTC (required for calls over mobile data / CGNAT)
VITE_TURN_URL=turn:lightweight.cat:3478
VITE_TURN_USERNAME=lightweight
VITE_TURN_CREDENTIAL=your_turn_password