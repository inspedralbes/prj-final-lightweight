# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.
POSTGRES_USER=username
POSTGRES_PASSWORD=username_password
POSTGRES_DB=database_name

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@lw-postgres:5432/${POSTGRES_DB}?schema=public"
FRONTEND_URL="http://localhost:5173"

# Mail — Gmail OAuth2 (producción). En dev se ignoran y se usa Ethereal automáticamente.
MAIL_USER=your@gmail.com
MAIL_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
MAIL_OAUTH_CLIENT_SECRET=your-client-secret
MAIL_OAUTH_REFRESH_TOKEN=your-refresh-token
RESET_TOKEN_EXPIRY_MINUTES=30

# Single-session enforcement — grace period (ms) before clearing session on socket disconnect.
# Allows page refreshes without locking the user out. Default: 30000 (30 s).
SESSION_DISCONNECT_TIMEOUT_MS=3000

# E2E testing flag — enables the /testing/* endpoints (reset, seed, login).
# DO NOT SET TO true IN PRODUCTION. The backend additionally refuses to load TestingModule
# when NODE_ENV=production, but keep this off in any prod-like environment as defense in depth.
E2E_TESTING=false